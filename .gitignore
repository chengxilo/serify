# Binaries (compiled executables only, not source directories)
/serify
/serify.exe
runner
runner.exe
**/worker
**/worker.exe
!/worker/
# taskstore example: client and server binaries sit beside the worker and,
# unlike it, are not named `worker`. Spelled out per language rather than
# globbed: core.ignorecase is true on a case-insensitive checkout, where
# `examples/taskstore/*/client` also swallows the C# client *project*
# directory, examples/taskstore/csharp/Client/. Rust's go to target/.
examples/taskstore/go/client
examples/taskstore/go/server
examples/taskstore/cpp/client
examples/taskstore/cpp/server
# Elixir escript test workers (rebuilt by the harness)
audit_worker
is_worker
wrong_worker

# Go
/vendor/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
.mypy_cache/

# Node
node_modules/
dist/
*.js.map

# Rust
target/
**/target/

# .NET / C#
bin/
obj/
**/bin/
**/obj/
# ...but Rust keeps real source in src/bin/, one file per binary target, and
# the rules above are broad enough to swallow it.
!**/src/bin/
*.user
*.suo

# IDE
.vscode/settings.json
.idea/
*.swp

# act
.act/
.actrc

# Design docs (internal, not shipped)
design/

# Claude Code internal
.claude/

# OS
.DS_Store
Thumbs.db

# Elixir
_build/
deps/
# BEAM writes this on a VM crash (e.g. an Elixir worker dying mid-run)
erl_crash.dump

# Build cache markers
.build_marker

# Test artifacts
*.test
out.csv

# maven-shade regenerates these on every build, stripping license headers
dependency-reduced-pom.xml

# Packaging artifacts (see RELEASING.md); dist/ is already ignored above
*.tgz
*.crate
*.nupkg
lib/elixir/serify-*.tar

# Go example worker binaries: each example module's name ends in the binary
# `go build` drops beside its source (example-go, example-audit, …).
/examples/*/go/example-*
