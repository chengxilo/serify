{
    "name": "chengxilo/serify",
    "description": "PHP worker library for the serify cross-language serialization conformance harness",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Serify\\": "lib/php/src/"
        }
    },
    "archive": {
        "exclude": [
            "*",
            ".*",
            "!/composer.json",
            "!/LICENSE",
            "!/README.md",
            "!/lib/php/src"
        ]
    }
}
