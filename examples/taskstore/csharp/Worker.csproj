<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Worker</AssemblyName>
  </PropertyGroup>

  <!-- The client is its own project under Client/, so keep its sources and its
       build output out of this one. The shared codec files stay here and the
       client includes them by path. -->
  <ItemGroup>
    <Compile Remove="Client/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../lib/csharp/Serify.csproj" />
  </ItemGroup>
</Project>
